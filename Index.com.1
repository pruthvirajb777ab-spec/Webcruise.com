
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Community X | Project Archive</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

:root {
  --bg: #090909;
  --panel: #121212;
  --line: #292929;
  --text: #f5f5f5;
  --muted: #929292;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  background: var(--bg);
  color: var(--text);
  font-family: 'Inter', sans-serif;
  min-height: 100vh;
}

nav {
  height: 76px;
  padding: 0 7%;
  border-bottom: 1px solid var(--line);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.logo { font-size: 20px; font-weight: 800; letter-spacing: -1px; }
.logo span { color: #888; }

nav a {
  color: #bbb;
  text-decoration: none;
  font-size: 13px;
  margin-left: 24px;
}

nav a:hover { color: white; }

.hero {
  padding: 100px 7% 75px;
  border-bottom: 1px solid var(--line);
}

.tag {
  display: inline-block;
  color: #aaa;
  border: 1px solid #333;
  padding: 8px 12px;
  border-radius: 30px;
  font-size: 11px;
  letter-spacing: 1px;
  margin-bottom: 28px;
}

h1 {
  font-size: clamp(43px, 8vw, 90px);
  line-height: 1.02;
  letter-spacing: -5px;
  max-width: 850px;
}

h1 span { color: #777; }

.hero p {
  color: var(--muted);
  line-height: 1.8;
  max-width: 520px;
  margin-top: 24px;
  font-size: 14px;
}

.actions { display: flex; gap: 12px; margin-top: 32px; flex-wrap: wrap; }

.btn {
  display: inline-block;
  padding: 13px 19px;
  border: 1px solid #333;
  border-radius: 6px;
  color: white;
  text-decoration: none;
  background: #171717;
  cursor: pointer;
  font-size: 12px;
  font-family: inherit;
}

.btn.primary { background: white; color: black; border-color: white; }
.btn:hover { opacity: .8; }

.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border-bottom: 1px solid var(--line);
  padding: 28px 7%;
}

.stat { border-right: 1px solid var(--line); padding-left: 24px; }
.stat:first-child { padding-left: 0; }
.stat:last-child { border: 0; }
.stat strong { font-size: 25px; }
.stat small { display: block; color: var(--muted); margin-top: 8px; font-size: 11px; }

section.content { padding: 65px 7%; }

.section-top {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 20px;
  margin-bottom: 30px;
  flex-wrap: wrap;
}

h2 { font-size: 28px; letter-spacing: -1px; }
.sub { color: var(--muted); font-size: 12px; margin-top: 10px; }

.search {
  background: var(--panel);
  border: 1px solid var(--line);
  color: white;
  border-radius: 6px;
  padding: 12px;
  width: min(100%, 250px);
  outline: none;
}

.filters { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 25px; }

.filter {
  padding: 9px 13px;
  color: #aaa;
  background: transparent;
  border: 1px solid var(--line);
  border-radius: 5px;
  cursor: pointer;
}

.filter.active { background: white; color: black; }

.grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
}

.card {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 9px;
  overflow: hidden;
  transition: transform .2s, border-color .2s;
}

.card:hover { transform: translateY(-4px); border-color: #666; }

.cover {
  height: 160px;
  padding: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: radial-gradient(ellipse at center, #303030, #151515 70%);
  font-size: 42px;
  font-weight: 800;
  letter-spacing: -3px;
  color: #ddd;
}

.card-body { padding: 21px; }
.category { color: #999; font-size: 10px; text-transform: uppercase; letter-spacing: 1px; }
.card h3 { font-size: 17px; margin-top: 11px; }
.card p { color: var(--muted); font-size: 12px; line-height: 1.7; margin-top: 10px; }
.card-foot { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 22px; }

.small-btn {
  padding: 9px 11px;
  font-size: 11px;
  border-radius: 4px;
  color: white;
  background: #222;
  border: 1px solid #333;
  cursor: pointer;
  text-decoration: none;
}

.empty {
  display: none;
  color: var(--muted);
  padding: 30px 0;
}

.upload-area {
  background: var(--panel);
  border: 1px dashed #444;
  padding: 35px;
  border-radius: 9px;
  text-align: center;
}

.upload-area p { color: var(--muted); font-size: 12px; margin: 12px 0 20px; }

#fileList { margin-top: 18px; text-align: left; }
.file-row {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  padding: 12px 0;
  border-bottom: 1px solid var(--line);
  font-size: 12px;
  overflow-wrap: anywhere;
}

.resources {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
}

.resource {
  border: 1px solid var(--line);
  padding: 22px;
  border-radius: 8px;
  background: #101010;
}

.resource strong { font-size: 14px; }
.resource p { color: var(--muted); font-size: 12px; margin-top: 9px; line-height: 1.7; }

footer {
  padding: 30px 7%;
  border-top: 1px solid var(--line);
  color: #777;
  font-size: 11px;
  display: flex;
  justify-content: space-between;
  gap: 15px;
  flex-wrap: wrap;
}

@media(max-width: 850px) {
  .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .resources { grid-template-columns: 1fr; }
}

@media(max-width: 560px) {
  nav { padding: 0 5%; height: 65px; }
  nav a { margin-left: 12px; font-size: 11px; }
  .hero { padding: 75px 5% 55px; }
  h1 { letter-spacing: -2px; }
  section.content { padding: 48px 5%; }
  .stats { padding: 24px 5%; }
  .stat { padding-left: 12px; }
  .stat strong { font-size: 20px; }
  .stat small { font-size: 10px; }
  .grid { grid-template-columns: 1fr; }
  .cover { height: 145px; }
}
</style>
</head>

<body>

<nav>
  <div class="logo">COMMUNITY<span> X.</span></div>
  <div>
    <a href="#projects">Projects</a>
    <a href="#vault">Vault</a>
    <a href="#resources">Resources</a>
  </div>
</nav>

<header class="hero">
  <div class="tag">ENGINEERING · CSE · INNOVATION</div>
  <h1>Ideas become<br><span>real projects.</span></h1>
  <p>
    A personal engineering portfolio and digital workspace.
    Explore our builds, document our research, and keep every
    project, report, and resource organised in one place.
  </p>
  <div class="actions">
    <a href="#projects" class="btn primary">Explore projects ↗</a>
    <a href="#vault" class="btn">Open document vault ↓</a>
  </div>
</header>

<div class="stats">
  <div class="stat"><strong id="projectCount">03</strong><small>PROJECTS</small></div>
  <div class="stat"><strong id="documentCount">00</strong><small>DOCUMENTS SELECTED</small></div>
  <div class="stat"><strong>01</strong><small>ENGINEERING JOURNEY</small></div>
</div>

<section class="content" id="projects">
  <div class="section-top">
    <div>
      <h2>Selected work.</h2>
      <p class="sub">Projects, experiments and ideas in progress.</p>
    </div>
    <input id="search" class="search" placeholder="Search projects..." />
  </div>

  <div class="filters">
    <button class="filter active" data-filter="all">All work</button>
    <button class="filter" data-filter="software">Software</button>
    <button class="filter" data-filter="research">Research</button>
    <button class="filter" data-filter="design">Design</button>
  </div>

  <div class="grid" id="projectGrid">

    <article class="card" data-category="software">
      <div class="cover">01 / BLE</div>
      <div class="card-body">
        <div class="category">Software · IoT</div>
        <h3>Smart Attendance System</h3>
        <p>A student attendance concept using Bluetooth Low Energy (BLE), with a focus on efficient attendance tracking.</p>
        <div class="card-foot">
          <button class="small-btn" onclick="addProjectFile('Smart Attendance System')">Attach report</button>
          <button class="small-btn" onclick="showDetails('Smart Attendance System','BLE-based attendance concept with a student dashboard and attendance records.')">View details ↗</button>
        </div>
      </div>
    </article>

    <article class="card" data-category="research">
      <div class="cover">02 / AI</div>
      <div class="card-body">
        <div class="category">Research · AI</div>
        <h3>AI Research Archive</h3>
        <p>A collection of AI applications, research notes, references and technical documentation.</p>
        <div class="card-foot">
          <button class="small-btn" onclick="addProjectFile('AI Research Archive')">Attach report</button>
          <button class="small-btn" onclick="showDetails('AI Research Archive','Store your AI research, source references, findings and presentation files.')">View details ↗</button>
        </div>
      </div>
    </article>

    <article class="card" data-category="design">
      <div class="cover">03 / UI</div>
      <div class="card-body">
        <div class="category">Design · Web</div>
        <h3>Student Resource Hub</h3>
        <p>A digital library concept for organising study materials, notes, PDFs and useful student resources.</p>
        <div class="card-foot">
          <button class="small-btn" onclick="addProjectFile('Student Resource Hub')">Attach report</button>
          <button class="small-btn" onclick="showDetails('Student Resource Hub','A student-facing resource hub for notes, course documents and learning materials.')">View details ↗</button>
        </div>
      </div>
    </article>

  </div>
  <p class="empty" id="empty">No projects match your search.</p>
</section>

<section class="content" id="vault">
  <div class="section-top">
    <div>
      <h2>Document vault.</h2>
      <p class="sub">Select project reports, PDFs, presentations and other files.</p>
    </div>
  </div>

  <div class="upload-area">
    <div style="font-size:32px">↥</div>
    <h3 style="margin-top:14px">Drop your files into your workflow.</h3>
    <p>PDF, DOC, DOCX, PPT, PPTX, XLS, XLSX, TXT and ZIP files.</p>
    <input type="file" id="fileInput" multiple hidden
      accept=".pdf,.doc,.docx,.ppt,.pptx,.xls,.xlsx,.txt,.zip">
    <button class="btn primary" onclick="document.getElementById('fileInput').click()">+ Select files</button>
    <div id="fileList"></div>
  </div>
</section>

<section class="content" id="resources">
  <div class="section-top">
    <div>
      <h2>Resource library.</h2>
      <p class="sub">Your workspace for learning and building.</p>
    </div>
  </div>

  <div class="resources">
    <div class="resource">
      <strong>01 — Learning notes</strong>
      <p>Organise programming notes, CSE subjects and semester study material.</p>
    </div>
    <div class="resource">
      <strong>02 — Research & reports</strong>
      <p>Keep project abstracts, references, research papers and documentation together.</p>
    </div>
    <div class="resource">
      <strong>03 — Project releases</strong>
      <p>Keep source code, screenshots, demos and version links for each project.</p>
    </div>
  </div>
</section>

<footer>
  <span>© 2026 COMMUNITY X. ALL RIGHTS RESERVED.</span>
  <span>BUILT TO CREATE. DESIGNED TO LAST.</span>
</footer>

<script>
const search = document.getElementById('search');
const cards = [...document.querySelectorAll('.card')];
const filters = [...document.querySelectorAll('.filter')];
let activeFilter = 'all';

function updateProjects() {
  const term = search.value.toLowerCase();
  let visible = 0;

  cards.forEach(card => {
    const matchesText = card.innerText.toLowerCase().includes(term);
    const matchesFilter = activeFilter === 'all' ||
                          card.dataset.category === activeFilter;
    card.style.display = matchesText && matchesFilter ? '' : 'none';
    if (matchesText && matchesFilter) visible++;
  });

  document.getElementById('empty').style.display = visible ? 'none' : 'block';
}

search.addEventListener('input', updateProjects);

filters.forEach(button => {
  button.addEventListener('click', () => {
    filters.forEach(b => b.classList.remove('active'));
    button.classList.add('active');
    activeFilter = button.dataset.filter;
    updateProjects();
  });
});

function showDetails(name, description) {
  alert(name + '\\n\\n' + description +
        '\\n\\nAdd your own project documentation and demo links to this card.');
}

function addProjectFile(project) {
  document.getElementById('fileInput').dataset.project = project;
  document.getElementById('fileInput').click();
}

const input = document.getElementById('fileInput');
const list = document.getElementById('fileList');
let selectedCount = 0;

input.addEventListener('change', () => {
  [...input.files].forEach(file => {
    selectedCount++;
    const row = document.createElement('div');
    row.className = 'file-row';

    const name = document.createElement('span');
    name.textContent = '↳ ' + file.name +
      (input.dataset.project ? ' · ' + input.dataset.project : '');

    const download = document.createElement('a');
    download.textContent = 'Download';
    download.href = URL.createObjectURL(file);
    download.download = file.name;
    download.className = 'small-btn';

    row.append(name, download);
    list.appendChild(row);
  });

  document.getElementById('documentCount').textContent =
    String(selectedCount).padStart(2, '0');

  input.value = '';
});

document.getElementById('projectCount').textContent =
  String(cards.length).padStart(2, '0');
</script>

</body>
</html>
